{
  "name": "CcMart",
  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "11"
    }
  },
  "remoteEnv": {
    "JAVA_HOME": "/usr/lib/jvm/java-11-openjdk-amd64",
    "JAVA_TOOL_OPTIONS": "--add-opens=java.base/javax.security.auth=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED --add-opens=java.base/java.nio=ALL-UNNAMED --add-opens=java.base/sun.nio.ch=ALL-UNNAMED"
  }
}